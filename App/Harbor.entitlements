<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A terminal runs arbitrary programs, so it can't use the App Sandbox. It ships with
	     the Hardened Runtime instead; the only exception is letting scripts run in a tab
	     (osascript, shortcuts) ask for Automation permission. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
